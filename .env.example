# Runtime: local is deterministic and requires no AWS account. strands enables
# the real Strands agent with the selected provider (Ollama or Bedrock).
SUPERSHIELD_MODE=local
SUPERSHIELD_STRANDS_PROVIDER=ollama
SUPERSHIELD_OLLAMA_MODEL=qwen3:0.6b
SUPERSHIELD_OLLAMA_HOST=http://localhost:11434
SUPERSHIELD_STORAGE_BACKEND=memory
SUPERSHIELD_PUBLIC_DEMO=false
SUPERSHIELD_ALLOW_INLINE_DOCUMENTS=true
SUPERSHIELD_APPROVAL_TTL_SECONDS=600
SUPERSHIELD_APPROVAL_SECRET=replace-with-at-least-32-random-characters
SUPERSHIELD_CASE_TTL_SECONDS=86400
SUPERSHIELD_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SUPERSHIELD_MAX_DOCUMENTS=20
SUPERSHIELD_MAX_DOCUMENT_BYTES=250000

# AWS/cloud configuration. Resource names are emitted by CloudFormation.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
SUPERSHIELD_DYNAMODB_TABLE=
SUPERSHIELD_S3_BUCKET=
SUPERSHIELD_S3_KMS_KEY_ID=
SUPERSHIELD_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
SUPERSHIELD_BEDROCK_EXTRACTION_MODEL_ID=amazon.nova-lite-v1:0
SUPERSHIELD_AGENTCORE_RUNTIME_ARN=
SUPERSHIELD_AGENTCORE_ENDPOINT=

# Optional, off by default. Recipient must be a team-owned SES-verified address.
SUPERSHIELD_ENABLE_TEST_EMAIL=false
SUPERSHIELD_TEST_EMAIL_RECIPIENT=
SUPERSHIELD_SES_IDENTITY_ARN=

# Evaluation adapter. Either URL or Python callable may be supplied.
SUPERSHIELD_EVAL_BASE_URL=http://localhost:8000
SUPERSHIELD_EVAL_CALLABLE=supershield.evaluation:run_case
SUPERSHIELD_EVAL_TIMEOUT_SECONDS=120
