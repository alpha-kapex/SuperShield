flowchart TB
  classDef human fill:#FFF4D6,stroke:#8A5A00,color:#2B1B00,stroke-width:2px
  classDef edge fill:#E8F1FF,stroke:#1456A0,color:#082B54,stroke-width:2px
  classDef agent fill:#E9F8EF,stroke:#157347,color:#073D25,stroke-width:2px
  classDef tool fill:#F4ECFF,stroke:#6F42C1,color:#32156D,stroke-width:2px
  classDef data fill:#F5F5F5,stroke:#4B5563,color:#111827,stroke-width:2px
  classDef guard fill:#FFE8E8,stroke:#B42318,color:#5F0B05,stroke-width:2px

  Human["Human reviewer<br/>constraints + explicit approvals"]:::human
  Browser["React curated-case demo<br/>12 synthetic cases only"]:::edge

  subgraph EC2["Amazon EC2 · t4g.large · direct HTTP"]
    Nginx["Rate-limited nginx<br/>public TCP 80 · security headers"]:::edge
    API["FastAPI BFF<br/>session binding · SSE · expiry"]:::edge
    Supervisor["Strands SuperShield Supervisor<br/>bounded coordination"]:::agent
    Ollama["Private Ollama<br/>qwen3:8b-q4_K_M"]:::agent
    Memory[("In-memory case/run state<br/>ephemeral by design")]:::data

    subgraph Tools["Authoritative bounded tools"]
      Evidence["Evidence Collector<br/>claims + citations + hashes"]:::tool
      Skeptic["Skeptic<br/>contradictions + missing support"]:::tool
      Finance["Deterministic Finance<br/>Decimal scenarios"]:::tool
      Location["Location Risk<br/>synthetic screening"]:::tool
      Validator["Evidence Validator<br/>no evidence → unresolved"]:::guard
      Approval["Human Approval Tool<br/>payload hash + expiry"]:::guard
    end
  end

  SSM["AWS Systems Manager<br/>administration · no SSH"]:::data
  EventBridge["Amazon EventBridge<br/>2026-10-16 06:00 UTC"]:::guard
  Lambda["AWS Lambda<br/>terminate exact instance"]:::guard

  Human --> Browser
  Browser -->|HTTP · synthetic data only| Nginx --> API --> Supervisor
  Supervisor <--> Ollama
  Supervisor --> Evidence
  Supervisor --> Skeptic
  Supervisor --> Finance
  Supervisor --> Location
  Evidence --> Validator
  Skeptic --> Validator
  Finance --> Validator
  Location --> Validator
  Validator --> Supervisor
  Supervisor --> Approval --> API
  API <--> Memory
  SSM -. manages .-> EC2
  EventBridge --> Lambda -->|terminate instance + root EBS| EC2
